# Copy to .env before first run:  cp .env.example .env
#
# Required. Without it the service cannot fetch issuer public keys on a cold
# start, and verification fails until a .pubkeys.json cache exists.
ISSUER_URL=http://localhost:3001

PORT=3003

# Optional. Defaults to receipts.db in this directory.
# DB_PATH=receipts.db

# Deployed (Vercel): receipts, the single-use registry and pending requests live
# in Redis instead of sqlite + memory, because serverless instances share neither.
# Provisioned by the Upstash integration; KV_REST_API_URL / KV_REST_API_TOKEN work too.
# Setting these locally switches the store; on Vercel they are required.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
