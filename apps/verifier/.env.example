# Copy to .env.local before first run:  cp .env.example .env.local
#
# Next.js inlines NEXT_PUBLIC_* at build time, so these must be set before
# `next build`, not just at runtime.

# Used only to fetch and cache issuer public keys. Verification itself is
# local — once cached, the verifier keeps working with the issuer offline.
NEXT_PUBLIC_ISSUER_URL=http://localhost:3001

# This verifier's own backend, as called by THIS browser. On the laptop running
# the stack, localhost is correct.
NEXT_PUBLIC_VERIFIER_API_URL=http://localhost:3003

# The same backend, as called by the PHONE — this value is embedded in the QR.
# Leave unset for an all-local demo. For a phone demo, point it at the wallet
# tunnel's proxy path, e.g.
#   NEXT_PUBLIC_VERIFIER_API_PUBLIC_URL=https://<tunnel>.ngrok-free.app/api/verifier
# A phone cannot reach localhost, so if this is wrong the QR scans and then the
# proof never arrives. `npm run doctor` catches exactly this mismatch.
# NEXT_PUBLIC_VERIFIER_API_PUBLIC_URL=

# Where the request QR deep-links to (the holder wallet).
# For a phone demo this must be the tunnel URL, not localhost.
NEXT_PUBLIC_HOLDER_URL=http://localhost:3000

# Identifies this verifier in receipts and in proof audience binding.
NEXT_PUBLIC_VERIFIER_ID=pruve_demo_venue
