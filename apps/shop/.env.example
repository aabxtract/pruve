# Copy to .env.local.  Wallet URL the QR deep-links to.
NEXT_PUBLIC_HOLDER_URL=http://localhost:3000

# The store's own API, as the PHONE must reach it. For a tunnelled demo this
# is the wallet tunnel's proxy path; leave unset for a single-machine demo.
# NEXT_PUBLIC_SHOP_API_PUBLIC_URL=https://<tunnel>/api/shop

# Server-side only: where to fetch issuer public keys once, then cache.
ISSUER_ORIGIN=http://localhost:3001
