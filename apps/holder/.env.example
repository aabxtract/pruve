# Copy to .env.local before first run:  cp .env.example .env.local
#
# Next.js inlines NEXT_PUBLIC_* at build time, so these must be set before
# `next build`, not just at runtime.

# Where the wallet fetches credentials from.
#
# For a PHONE demo set these two to the relative proxy paths instead:
#   NEXT_PUBLIC_ISSUER_URL=/api/issuer
#   NEXT_PUBLIC_VERIFIER_API_URL=/api/verifier
# next.config.mjs forwards those to the real backends server-side, so the phone
# only needs ONE tunnel (this app) and every request is same-origin — no CORS.
NEXT_PUBLIC_ISSUER_URL=http://localhost:3001

# Where a bound proof is submitted (the verifier's own backend).
# Note: the QR usually supplies this per-request via ?api=, so this is the
# fallback for proofs started from inside the wallet.
NEXT_PUBLIC_VERIFIER_API_URL=http://localhost:3003

# Base URL used to build shareable proof links for the unbound / WhatsApp flow.
NEXT_PUBLIC_VERIFIER_URL=http://localhost:3002
